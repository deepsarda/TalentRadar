NODE_ENV=development
PORT=3000
WEB_DIST_DIR=apps/web/dist
RUN_WORKER_IN_API=false

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/talentradar
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# synthetic_only on Gemini's free tier (content may be used by Google); paid_private for real CVs.
MODEL_DATA_POLICY=synthetic_only
REPO_TOKEN_BUDGET=12000

# Rate limits (defaults shown). Gemini limits are per Google Cloud project: check AI Studio.
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_TOKENS_PER_MINUTE=250000
GITHUB_REQUESTS_PER_HOUR=5000

# Email: without RESEND_API_KEY, notifications are only logged (addresses masked).
RESEND_API_KEY=
EMAIL_FROM=TalentRadar <onboarding@resend.dev>
